DATABASE_URL=postgresql+psycopg://recruitment_user:change-me@localhost:5432/recruitment_db
POSTGRES_DB=recruitment_db
POSTGRES_USER=recruitment_user
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
SECRET_KEY=replace-with-a-local-development-secret
APP_ENV=development
# Fournisseur Groq via son endpoint compatible OpenAI.
LLM_PROVIDER=groq
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_RETRY_BACKOFF_SECONDS=5
WORKFLOW_STALE_TIMEOUT_SECONDS=3600
MATCHING_REQUIRED_SKILLS_WEIGHT=40
MATCHING_EXPERIENCE_WEIGHT=20
MATCHING_DEGREE_WEIGHT=15
MATCHING_PREFERRED_SKILLS_WEIGHT=10
MATCHING_LANGUAGES_WEIGHT=5
MATCHING_DOCUMENTS_WEIGHT=10
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
ADMIN_NOTIFICATION_EMAIL=admin@example.test
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10

# OCR (documents scannés) : langues Tesseract, restreintes à celles installées
OCR_LANGUAGES=fra+eng+ara
